# ==============================================================================
# Djadwal - Production & Development Environment Template
# Copy this file to '.env' and populate with your own values.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# --- Server & Runtime Configuration ---
NODE_ENV=development
PORT=3001

# --- Security & Authentication (Strict Requirements) ---
# Primary JWT signing key (MUST be at least 32 characters long)
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters

# Optional: Previous key during zero-downtime key rotation
# Allows previously logged-in users to remain authenticated while transitioning to new JWT_SECRET
JWT_SECRET_PREVIOUS=

# Session cookie encryption key
SESSION_SECRET=replace_with_random_session_secret_min_16_chars

# --- Turso Cloud Database (Primary Database - Server Side Only) ---
TURSO_DATABASE_URL=libsql://your-database.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# --- Server-Side AI Assistant (Zero Browser Leaks) ---
# Managed strictly via POST /api/ai/assist proxy
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Feature Flags
FEATURE_AI_PROXY=true
FEATURE_STRICT_ENV=true

# --- Google OAuth 2.0 & Gmail API (Schedule Mailing) ---
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/email/oauth2callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# --- Alternative SMTP Mailer (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_16_characters
