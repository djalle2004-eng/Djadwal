# ==============================================================================
# Djadwal V1 - Environment Variables Template
# Copy this file to '.env' and populate with your own development/production values.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# --- Server & Runtime Configuration ---
NODE_ENV=development
PORT=3001
VITE_API_BASE_URL=http://localhost:3001

# --- Security & Sessions ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
SESSION_SECRET=your_session_secret_key_random

# --- Turso Cloud Database (Primary Database) ---
# Obtain from Turso CLI ('turso db show <name>') or https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
VITE_TURSO_DATABASE_URL=libsql://your-database.aws-eu-west-1.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here

# --- Google OAuth 2.0 & Gmail API (Schedule Mailing) ---
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/email/oauth2callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# --- Alternative SMTP Mailer (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_16_characters

# --- SQLite Cloud (Legacy / Backup / Migration) ---
SQLITECLOUD_HOST=your-subdomain.g4.sqlite.cloud
SQLITECLOUD_PORT=8860
SQLITECLOUD_USERNAME=apikey
SQLITECLOUD_PASSWORD=your_sqlitecloud_api_key
SQLITECLOUD_DATABASE=Djadwal
SQLITECLOUD_URL=sqlitecloud://your-subdomain.g4.sqlite.cloud:8860/Djadwal?apikey=your_sqlitecloud_api_key

# --- Supabase (Optional Integration) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Firebase / Firestore (Optional Integration) ---
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- AI Integration (Optional) ---
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
